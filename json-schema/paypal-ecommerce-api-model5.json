{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/verifone/refs/heads/main/json-schema/paypal-ecommerce-api-model5.json",
  "title": "Model5",
  "description": "Model5 from PayPal eComm API",
  "required": [
    "code",
    "message"
  ],
  "type": "object",
  "properties": {
    "code": {
      "type": "number",
      "description": "A 3-digit code which uniquely identify an error."
    },
    "details": {
      "$ref": "#/components/schemas/details"
    },
    "message": {
      "type": "string",
      "description": "A description of the error."
    },
    "timestamp": {
      "type": "string",
      "description": "Error timestamp",
      "format": "date"
    }
  }
}