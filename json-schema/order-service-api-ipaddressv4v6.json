{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/verifone/refs/heads/main/json-schema/order-service-api-ipaddressv4v6.json",
  "title": "IpAddressv4v6",
  "description": "A valid IPV4 or V6 address.",
  "type": "string",
  "anyOf": [
    {
      "format": "ipv4",
      "description": "Example : 232.100.1.1"
    },
    {
      "format": "ipv6",
      "description": "Example : 2405:204:638b:9daa:f3c8:a903:3227:c712"
    }
  ]
}