      "@id": "schema:streetAddress"
    },
    "postal_code": {
      "@id": "schema:postalCode"
    },
    "first_name": {
      "@id": "schema:givenName"
    },
    "last_name": {
      "@id": "schema:familyName"
    },
    "3d_secure_api": "verifone:3ds-authentication-api.json#",
    "checkout_api": "verifone:checkout-api.json#",
    "customer_api": "verifone:customer-api.json#",
    "verifone_ecommerce_api": "verifone:ecommerce-api.json#",
